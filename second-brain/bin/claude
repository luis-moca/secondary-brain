#!/bin/bash
# Claude Code de la app de Claude, para usarlo desde Terminal (por ejemplo para iniciar sesión una vez con /login).
# No instala nada: solo apunta a la versión más nueva que trae la app.
C=$(ls -d "$HOME/Library/Application Support/Claude/claude-code/"*/*/claude.app/Contents/MacOS/claude 2>/dev/null | sort -V | tail -1)
if [ -z "$C" ]; then echo "No encontré Claude Code dentro de la app de Claude." >&2; exit 1; fi
export PATH="$HOME/.local/node/bin:$PATH"
exec "$C" "$@"
